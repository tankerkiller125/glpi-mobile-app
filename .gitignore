# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Release artifacts collected by .github/workflows/release.yml
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing material — never commit these.
android/key.properties
**/*.jks
**/*.keystore
*.p8
*.p12
*.mobileprovision

# Per-instance Firebase config: this app initialises Firebase at runtime from
# the server's own config, so a checked-in google-services.json is both
# unnecessary and a way to leak someone's project.
**/google-services.json
**/GoogleService-Info.plist

# Local tool config
android/local.properties
.env
.env.*
